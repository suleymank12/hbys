        <member name="M:MiniHBYS.API.Controllers.PatientsController.Create(MiniHBYS.Core.DTOs.CreatePatientDto)">
             <summary>Yeni hasta oluşturur.</summary>
             <remarks>
             Örnek istek:
            
                 POST /api/patients
                 {
                   "name": "Ayşe",
                   "surname": "Yılmaz",
                   "nationalId": "12345678901",
                   "birthDate": "1990-05-14",
                   "phone": "05321234567",
                   "email": "ayse@example.com"
                 }
            
             Örnek yanıt:
            
                 {
                   "success": true,
                   "message": "Hasta oluşturuldu.",
                   "data": {
                     "id": 12,
                     "name": "Ayşe",
                     "surname": "Yılmaz",
                     "fullName": "Ayşe Yılmaz",
                     "nationalId": "12345678901",
                     "birthDate": "1990-05-14T00:00:00",
                     "phone": "05321234567",
                     "email": "ayse@example.com",
                     "createdAt": "2026-04-15T08:30:00Z"
                   }
                 }
             </remarks>
        </member>
